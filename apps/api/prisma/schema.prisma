generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                             String              @id @default(cuid())
  email                          String?             @unique
  password                       String?
  handle                         String?             @unique
  name                           String?
  avatarUrl                      String?
  privacy                        AccountPrivacy      @default(PRIVATE)
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime            @updatedAt
  termsAcceptedAt                DateTime?
  termsVersion                   String?
  bio                            String?
  handicap                       Float?
  homeGolfClub                   String?
  golfSlogan                     String?
  favoriteGolfDestination        String?
  bioPrivacy                     FieldPrivacy        @default(PUBLIC)
  handicapPrivacy                FieldPrivacy        @default(PUBLIC)
  homeGolfClubPrivacy            FieldPrivacy        @default(PUBLIC)
  golfSloganPrivacy              FieldPrivacy        @default(PUBLIC)
  favoriteGolfDestinationPrivacy FieldPrivacy        @default(PUBLIC)
  accounts                       AuthAccount[]
  comments                       Comment[]
  commentLikes                   CommentLike[]
  courseFollows                  CourseFollow[]
  courseRatings                  CourseRating[]
  courseSubmissions              CourseSubmission[]
  destinationFollows             DestinationFollow[]
  feedbacks                      Feedback[]
  following                      Follow[]            @relation("following")
  followers                      Follow[]            @relation("followers")
  likes                          Like[]
  posts                          Post[]
  reviews                        Review[]
  createdTrips                   Trip[]              @relation("TripCreator")
  createdTripInvites             TripInvite[]
  tripMemberships                TripMember[]
}

model AuthAccount {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  email          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model EmailLoginToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Follow {
  id          String       @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime     @default(now())
  decidedAt   DateTime?
  status      FollowStatus @default(PENDING)
  follower    User         @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User         @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followingId, status])
}

model Destination {
  id          String              @id @default(cuid())
  code        String              @unique
  name        String
  slug        String              @unique
  description String?
  coverImage  String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  followers   DestinationFollow[]

  @@index([code])
  @@index([slug])
  @@index([isActive])
}

model Course {
  id          String                    @id @default(cuid())
  name        String
  country     String
  region      String?
  city        String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  lat         Float
  lon         Float
  postalCode  String?
  active      Boolean                   @default(true)
  description String?
  holes       Int?
  location    Unsupported("geography")?
  osmId       String?
  par         Int?
  phone       String?
  source      String                    @default("csv")
  verified    Boolean                   @default(false)
  website     String?
  access      CourseAccess?
  followers   CourseFollow[]
  ratings     CourseRating[]
  posts       Post[]
  reviews     Review[]
  tripItems   TripItem[]

  @@unique([country, name, lat, lon], name: "course_unique_import_key")
  @@index([country])
  @@index([country, region])
  @@index([city])
  @@index([access])
  @@index([holes])
  @@index([location], type: Gist)
}

model CourseSubmission {
  id                String                  @id @default(cuid())
  name              String
  country           String
  city              String?
  region            String?
  website           String?
  lat               Float?
  lon               Float?
  holes             Int?
  par               Int?
  notes             String?
  imageUrl          String?
  status            CourseSubmissionStatus  @default(PENDING)
  submittedByUserId String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  submittedBy       User?                   @relation(fields: [submittedByUserId], references: [id])
  images            CourseSubmissionImage[]

  @@index([status])
  @@index([country])
  @@index([submittedByUserId])
}

model CourseSubmissionImage {
  id                 String           @id @default(cuid())
  courseSubmissionId String
  url                String
  path               String
  originalName       String?
  mimeType           String
  size               Int
  createdAt          DateTime         @default(now())
  courseSubmission   CourseSubmission @relation(fields: [courseSubmissionId], references: [id], onDelete: Cascade)

  @@index([courseSubmissionId])
}

model CourseRating {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  courseId  String
  overall   Float
  condition Float?
  layout    Float?
  scenery   Float?
  value     Float?
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Post {
  id         String      @id @default(cuid())
  userId     String
  courseId   String
  content    String
  visibility Visibility  @default(FOLLOWERS)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  lat        Float?
  lon        Float?
  comments   Comment[]
  likes      Like[]
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  images     PostImage[]

  @@index([courseId, createdAt])
  @@index([lat, lon])
}

model PostImage {
  id     String @id @default(cuid())
  postId String
  url    String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime      @default(now())
  parentId  String?
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     CommentLike[]

  @@index([postId, createdAt])
  @@index([parentId])
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model CourseFollow {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model DestinationFollow {
  id            String      @id @default(cuid())
  userId        String
  destinationId String
  createdAt     DateTime    @default(now())
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
  @@index([destinationId])
}

model Review {
  id           String   @id @default(cuid())
  userId       String
  courseId     String
  overall      Int
  maintenance  Int?
  layout       Int?
  value        Int?
  organization Int?
  scenery      Int?
  text         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model Feedback {
  id        String   @id @default(cuid())
  message   String
  url       String?
  userId    String?
  createdAt DateTime @default(now())
  category  String   @default("other")
  device    String?
  userAgent String?
  user      User?    @relation(fields: [userId], references: [id])
}

model Trip {
  id            String         @id @default(cuid())
  description   String?
  visibility    TripVisibility @default(PRIVATE)
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  title         String
  destination   String?
  coverImageUrl String?
  createdBy     User           @relation("TripCreator", fields: [createdById], references: [id], onDelete: Cascade)
  invites       TripInvite[]
  items         TripItem[]
  members       TripMember[]

  @@index([createdById])
  @@index([visibility])
}

model TripInvite {
  id              String    @id @default(cuid())
  tripId          String
  token           String    @unique
  createdByUserId String
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?
  expiresAt       DateTime?
  createdBy       User      @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  trip            Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([createdByUserId])
  @@index([revokedAt])
}

model TripMember {
  id                 String                @id @default(cuid())
  tripId             String
  userId             String?
  displayName        String?
  isGuest            Boolean               @default(false)
  role               TripRole              @default(MEMBER)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  itemParticipations TripItemParticipant[]
  paidItems          TripItem[]            @relation("TripItemPayer")
  trip               Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user               User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId])
}

model TripItem {
  id                     String                @id @default(cuid())
  tripId                 String
  courseId               String?
  type                   TripItemType          @default(COURSE)
  title                  String?
  notes                  String?
  startsAt               DateTime?
  sortOrder              Int                   @default(0)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  address                String?
  bookingRef             String?
  caddyFee               Float?
  cartFee                Float?
  currency               String?
  date                   DateTime?
  directPrice            Float?
  endDate                DateTime?
  endTime                String?
  greenFee               Float?
  includeCaddyFeeInSplit Boolean               @default(true)
  includeCartFeeInSplit  Boolean               @default(true)
  includeGreenFeeInSplit Boolean               @default(true)
  locationName           String?
  paidByMemberId         String?
  provider               String?
  providerPrice          Float?
  startTime              String?
  course                 Course?               @relation(fields: [courseId], references: [id])
  paidByMember           TripMember?           @relation("TripItemPayer", fields: [paidByMemberId], references: [id])
  participants           TripItemParticipant[]
  trip                   Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([courseId])
  @@index([paidByMemberId])
  @@index([tripId, sortOrder])
}

model TripItemParticipant {
  id           String     @id @default(cuid())
  tripItemId   String
  tripMemberId String
  createdAt    DateTime   @default(now())
  tripItem     TripItem   @relation(fields: [tripItemId], references: [id], onDelete: Cascade)
  tripMember   TripMember @relation(fields: [tripMemberId], references: [id], onDelete: Cascade)

  @@unique([tripItemId, tripMemberId])
  @@index([tripMemberId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum AccountPrivacy {
  PRIVATE
  PUBLIC
}

enum Visibility {
  FOLLOWERS
  PUBLIC
  PRIVATE
}

enum FieldPrivacy {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum AuthProvider {
  GOOGLE
  APPLE
  FACEBOOK
}

enum CourseAccess {
  PUBLIC
  PRIVATE
  RESORT
  SEMI_PRIVATE
  MUNICIPAL
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

enum CourseSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TripVisibility {
  PRIVATE
  SHARED
  PUBLIC
}

enum TripRole {
  OWNER
  EDITOR
  VIEWER
  ADMIN
  MEMBER
}

enum TripItemType {
  COURSE
  NOTE
  golf_round
  hotel
  transfer
  car_rental
  flight
  free_day
  note
}
