model ContentModerationCase {
  id String @id @default(cuid())
  userId String
  scope String
  digest String
  blockedFingerprint String?
  status String @default("PENDING")
  categories String[]
  text String?
  bytes Bytes?
  mimeType String?
  reviewerId String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  decidedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, scope, digest])
  @@index([blockedFingerprint])
  @@index([expiresAt])
  @@index([status, createdAt])
}

// Quarantined new posts never enter Post/feed queries until an admin publishes.
model PendingPost {
  id String @id @default(cuid())
  userId String
  courseId String
  content String
  visibility Visibility
  state String @default("PENDING")
  dedupKey String? @unique
  reviewCaseIds String[]
  categories String[]
  postId String?
  reviewerId String?
  publishToken String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  decidedAt DateTime?
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  images PendingPostImage[]
  @@index([state, createdAt])
  @@index([expiresAt])
}

model PendingPostImage {
  id String @id @default(cuid())
  pendingPostId String
  position Int
  mimeType String
  bytes Bytes
  pendingPost PendingPost @relation(fields: [pendingPostId], references: [id], onDelete: Cascade)
  @@unique([pendingPostId, position])
}
