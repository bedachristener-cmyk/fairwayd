datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum AccountPrivacy {
  PRIVATE
  PUBLIC
}

enum Visibility {
  PRIVATE
  FOLLOWERS
  PUBLIC
}

enum AuthProvider {
  GOOGLE
  APPLE
  FACEBOOK
}

enum CourseAccess {
  PUBLIC
  PRIVATE
  RESORT
  MUNICIPAL
  SEMI_PRIVATE
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

model User {
  id        String         @id @default(cuid())
  email     String?        @unique
  password  String?
  handle    String?        @unique
  name      String?
  avatarUrl String?
  privacy   AccountPrivacy @default(PRIVATE)

  termsAcceptedAt DateTime?
  termsVersion    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     AuthAccount[]
  posts        Post[]
  reviews      Review[]
  comments     Comment[]
  likes        Like[]
  commentLikes CommentLike[] // 👈 NEU
  feedbacks    Feedback[]

  followers Follow[] @relation("followers")
  following Follow[] @relation("following")

  courseFollows      CourseFollow[]
  destinationFollows DestinationFollow[]

  courseRatings CourseRating[]
}

model AuthAccount {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  email          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Follow {
  id          String       @id @default(cuid())
  followerId  String
  followingId String
  status      FollowStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  decidedAt   DateTime?

  follower  User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followingId, status])
}

model Destination {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  slug        String   @unique
  description String?
  coverImage  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  followers DestinationFollow[]

  @@index([code])
  @@index([slug])
  @@index([isActive])
}

model Course {
  id         String  @id @default(cuid())
  name       String
  city       String?
  postalCode String?
  region     String?
  country    String
  lat        Float
  lon        Float

  location Unsupported("geography(Point,4326)")?

  holes       Int?
  par         Int?
  access      CourseAccess?
  website     String?
  phone       String?
  description String?

  source   String  @default("csv")
  osmId    String?
  verified Boolean @default(false)
  active   Boolean @default(true)

  posts   Post[]
  reviews Review[]

  // Users following this course
  followers CourseFollow[]

  ratings CourseRating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([country, name, lat, lon], name: "course_unique_import_key")
  @@index([country])
  @@index([country, region])
  @@index([city])
  @@index([access])
  @@index([holes])
  @@index([location], type: Gist)
}

model CourseRating {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId   String
  courseId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Ratings
  overall   Float
  condition Float?
  layout    Float?
  scenery   Float?
  value     Float?

  @@unique([userId, courseId]) // 1 rating per user per course
}

model Post {
  id         String     @id @default(cuid())
  userId     String
  courseId   String
  content    String
  visibility Visibility @default(FOLLOWERS)

  lat Float?
  lon Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  comments Comment[]
  likes    Like[]
  images   PostImage[]

  @@index([courseId, createdAt])
  @@index([lat, lon])
}

model PostImage {
  id     String @id @default(cuid())
  postId String
  url    String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  parentId  String?
  content   String
  createdAt DateTime @default(now())

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("CommentReplies")
  likes   CommentLike[]

  @@index([postId, createdAt])
  @@index([parentId])
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model CourseFollow {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model DestinationFollow {
  id            String   @id @default(cuid())
  userId        String
  destinationId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
  @@index([destinationId])
}

model Review {
  id       String @id @default(cuid())
  userId   String
  courseId String

  overall      Int
  maintenance  Int?
  layout       Int?
  value        Int?
  organization Int?
  scenery      Int?

  text      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model Feedback {
  id        String   @id @default(cuid())
  message   String
  category  String   @default("other")
  url       String?
  device    String?
  userAgent String?
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
